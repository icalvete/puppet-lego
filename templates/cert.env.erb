# Gestionado por Puppet — lego::cert[<%= @name %>]. No editar a mano.
#
# Cada opcion de lego tiene su variable LEGO_*, asi que toda la configuracion
# cabe aqui y la unidad de systemd no necesita argumentos.

# --- Que se pide ---------------------------------------------------------
LEGO_DOMAINS=<%= @domains.join(',') %>
LEGO_EMAIL=<%= @email %>
LEGO_KEY_TYPE=<%= @key_type %>
LEGO_ACCEPT_TOS=true
# Separado por servidor ACME: ver el comentario en cert.pp.
LEGO_PATH=<%= @lego_path %>

# --- Contra quien ---------------------------------------------------------
# 'letsencrypt-staging' emite certificados que ningun navegador se cree, pero
# con limites mucho mas altos. 'letsencrypt' es produccion.
LEGO_SERVER=<%= @server %>

# --- Como demuestra el control del dominio --------------------------------
LEGO_DNS=route53
# Fijar la zona evita que lego la autodetecte listando las zonas de la cuenta,
# y con ello ahorra el permiso route53:ListHostedZones.
AWS_HOSTED_ZONE_ID=<%= @hosted_zone_id %>
AWS_REGION=<%= @aws_region %>
<% if @assume_role_arn -%>
# La zona esta en otra cuenta. Route53 no admite politicas basadas en recurso,
# asi que el host asume este rol. Las credenciales de partida las da el
# instance profile: no hay ninguna clave de AWS en disco.
AWS_ASSUME_ROLE_ARN=<%= @assume_role_arn %>
<% else -%>
# La zona esta en la cuenta del propio host: bastan las credenciales del
# instance profile, sin asumir nada.
<% end -%>

# --- Renovacion -----------------------------------------------------------
# Dias de vida restante a partir de los cuales se renueva.
#
# CUIDADO CON EL 0. La ayuda de lego dice que 0 significa "calcula
# dinamicamente: 1/3 de la vida restante". No es lo que hace: comprobado
# contra 5.4.1, con 0 la ventana de renovacion se abre EN EL INSTANTE DE LA
# CADUCIDAD, con y sin ARI. Ver lego::params::renew_days.
LEGO_RENEW_DAYS=<%= @renew_days %>

# --- Que hacer despues ----------------------------------------------------
LEGO_DEPLOY_HOOK=<%= @hook_file %>
